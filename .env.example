# Copy to .env and put your OWN key here. Never submit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=45
FINPILOT_OFFLINE=false
# Optional read-only IB Gateway. Install requirements-options.txt and sign in locally.
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=67
IBKR_MARKET_DATA_TYPE=1
# Optional local LoRA (separate .venv-ml; base model downloaded separately).
# FINPILOT_ADAPTER=models/finpilot-lora
# FINPILOT_ML_PYTHON=.venv-ml/Scripts/python.exe
# FINPILOT_HF_HOME=E:/CodexData/cache/huggingface
